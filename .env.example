# Copy this file to .env only for local development. Never commit .env.
# Railway stores the same values under the service's Variables tab.

# Required now
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# Required in Railway once the Postgres service has been added. Locally use a
# dedicated development database only; never commit a real connection string.
DATABASE_URL=postgresql://username:password@localhost:5432/discord_ai_agent

# The AI is intentionally off until steps 2-3 are complete.
AI_ENABLED=false
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Initial safety and cost defaults
AI_MAX_INPUT_CHARACTERS=2000
AI_MAX_OUTPUT_TOKENS=600
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT_REQUESTS=3
AI_USER_COOLDOWN_SECONDS=10
AI_DAILY_USER_LIMIT=30
AI_DAILY_GUILD_LIMIT=500

# Privacy-preserving context and explicit long-term memory defaults
AI_CONTEXT_MESSAGE_LIMIT=8
AI_MESSAGE_RETENTION_DAYS=30
AI_MEMORY_RETENTION_DAYS=180
AI_MEMORY_MAX_ITEMS=10
AI_MEMORY_MAX_CHARACTERS=500
