    print("========================================")
    print(f"✅ Showcase Bot is online as {bot.user}")
    print(f"🆔 Bot ID: {bot.user.id}")
    print("========================================")

    # Prevent the showcase from being processed repeatedly
    # after reconnects.
    if getattr(bot, "showcase_checked", False):
        return

    bot.showcase_checked = True

    # -----------------------------------------------------
    # FIND SHOWCASE CHANNEL
    # -----------------------------------------------------

    channel = discord.utils.get(
        bot.get_all_channels(),
        name=SHOWCASE_CHANNEL_NAME
    )

    if channel is None:

        print(
            f"❌ Channel '{SHOWCASE_CHANNEL_NAME}' was not found."
        )

        return

