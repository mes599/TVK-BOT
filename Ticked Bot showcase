# =========================================================
# CREATE TICKET FUNCTION
# =========================================================

async def create_ticket(
    interaction: discord.Interaction,
    ticket_type: str
):

    guild = interaction.guild

    if guild is None:
        await interaction.response.send_message(
            "❌ This can only be used inside a server.",
            ephemeral=True
        )
        return

    # -----------------------------------------------------
    # CHECK IF USER ALREADY HAS A TICKET
    # -----------------------------------------------------

    existing_ticket = None

    for channel in guild.text_channels:

        if (
            channel.topic
            and f"ticket-owner:{interaction.user.id}" in channel.topic
        ):
            existing_ticket = channel
            break

    if existing_ticket:

        await interaction.response.send_message(
            f"❌ You already have an open ticket: "
            f"{existing_ticket.mention}",
            ephemeral=True
        )

        return

    # -----------------------------------------------------
    # FIND OR CREATE TICKET CATEGORY
    # -----------------------------------------------------

    category = discord.utils.get(
        guild.categories,
        name=TICKET_CATEGORY_NAME
    )

    if category is None:

        try:

            category = await guild.create_category(
                TICKET_CATEGORY_NAME
            )

        except discord.Forbidden:

            await interaction.response.send_message(
                "❌ I don't have permission to create a category.",
                ephemeral=True
            )

            return

        except discord.HTTPException as error:

            await interaction.response.send_message(
                f"❌ Could not create the ticket category: {error}",
                ephemeral=True
            )

            return

    # -----------------------------------------------------
    # BOT MEMBER
    # -----------------------------------------------------

    bot_member = guild.me

    if bot_member is None:
        bot_member = guild.get_member(bot.user.id)

    if bot_member is None:

        await interaction.response.send_message(
            "❌ I could not find my bot member in this server.",
            ephemeral=True
        )

        return

    # -----------------------------------------------------
    # PERMISSIONS
    # -----------------------------------------------------

    overwrites = {

        guild.default_role: discord.PermissionOverwrite(
            view_channel=False
        ),

        interaction.user: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            attach_files=True
        ),

        bot_member: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            manage_channels=True,
            manage_messages=True
        )
    }

    # -----------------------------------------------------
    # CREATE CHANNEL
    # -----------------------------------------------------

    channel_name = (
        f"{ticket_type.lower()}-"
        f"{interaction.user.name.lower()}"
    )

    channel_name = (
        channel_name
        .replace(" ", "-")
        .replace("_", "-")
    )

    try:

        ticket_channel = await guild.create_text_channel(

            name=channel_name[:100],

            category=category,

            overwrites=overwrites,

            topic=(
                f"ticket-owner:{interaction.user.id} "
                f"| ticket-type:{ticket_type}"
            )
        )

    except discord.Forbidden:

        await interaction.response.send_message(
            "❌ I don't have permission to create ticket channels.",
            ephemeral=True
        )

        return

    except discord.HTTPException as error:

        await interaction.response.send_message(
            f"❌ Could not create the ticket channel: {error}",
            ephemeral=True
        )

        return

    # -----------------------------------------------------
    # TICKET MESSAGE
    # -----------------------------------------------------

    embed = discord.Embed(

        title="🎫 Ticket Bot",

        description=(
            "A powerful and fully customizable ticket "
            "system for your Discord server.\n\n"

            "✨ **Make it your own.**\n"
            "Design the bot exactly the way you want it — "
            "from buttons and messages to permissions "
            "and features.\n\n"

            "**Your vision. Your design. Your bot.**\n\n"

            "The showcase is only a demo. Your own bot "
            "can be built completely around your "
            "requirements."
        ),

        color=discord.Color.blurple()
    )

    embed.add_field(
        name="🛠️ Custom Ticket System",
        value=(
            "Create private tickets for support, "
            "orders or anything else you need."
        ),
        inline=False
    )

    embed.add_field(
        name="🎨 Fully Customizable",
        value=(
            "Buttons, messages, embeds, permissions, "
            "channels and features can all be changed."
        ),
        inline=False
    )

    embed.add_field(
        name="⚡ Built Around You",
        value=(
            "Your final bot doesn't have to look like "
            "this demo. It can be designed exactly "
            "according to your ideas."
        ),
        inline=False
    )

    embed.add_field(
        name="🚀 Want to see it in action?",
        value=(
            "Click **🎫 Try Demo** below to explore "
            "a small example of the ticket system."
        ),
        inline=False
    )

    embed.set_footer(
        text=f"{ticket_type} ticket • Fully customizable"
    )

    await ticket_channel.send(
        content=(
            f"👋 Welcome {interaction.user.mention}!\n"
            f"Your **{ticket_type}** ticket has been created."
        ),
        embed=embed,
        view=CloseTicketView()
    )

    # -----------------------------------------------------
    # CONFIRMATION
    # -----------------------------------------------------

    await interaction.response.send_message(
        f"✅ Your ticket has been created: "
        f"{ticket_channel.mention}",
        ephemeral=True
    )


