class ShowcaseView(discord.ui.View):

    def __init__(self):

        super().__init__(
            timeout=None
        )

    @discord.ui.button(
        label="🎫 Create Demo Ticket",
        style=discord.ButtonStyle.green,
        custom_id="create_showcase_demo"
    )
    async def create_demo(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):

        await create_demo_ticket(
            interaction
        )


# =========================================================
# BOT
# =========================================================

class ShowcaseBot(commands.Bot):

    async def setup_hook(self):

        # Register persistent buttons.

        self.add_view(
            ShowcaseView()
        )

        self.add_view(
            DemoActionView()
        )

        self.add_view(
            CloseTicketView()
        )


bot = ShowcaseBot(
    command_prefix="!",
    intents=intents
)


# =========================================================
# READY
# =========================================================

@bot.event
async def on_ready():

    print(
        "========================================"
    )

    print(
        f"✅ Showcase Bot is online as {bot.user}"
    )

    if bot.user:
        print(
            f"🆔 Bot ID: {bot.user.id}"
        )

    print(
        "========================================"
    )

    # Prevent duplicate showcase checks
    # after reconnects.

    if getattr(
        bot,
        "showcase_checked",
        False
    ):

        return

    bot.showcase_checked = True

    # -----------------------------------------------------
    # FIND SHOWCASE CHANNEL
    # -----------------------------------------------------

    channel = discord.utils.get(
        bot.get_all_channels(),
        name=SHOWCASE_CHANNEL_NAME
    )

