# BOT
# =========================================================

class ShowcaseBot(commands.Bot):

    async def setup_hook(self):

        self.add_view(
            TicketBotDemoView()
        )

        self.add_view(
            DemoTicketView()
        )

        self.add_view(
            CloseTicketView()
        )


bot = ShowcaseBot(
    command_prefix="!",
    intents=intents
)


